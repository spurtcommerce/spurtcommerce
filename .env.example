#
# APPLICATION
#
APP_NAME=your app name
APP_SCHEMA=http
APP_HOST=localhost
APP_PORT=your port
APP_ROUTE_PREFIX=/api
APP_BANNER=true

#
# SocketIo
#
TENANT_ID=1
APP_ID=<YOUR_APP_ID>

#
# LOGGING
#
LOG_LEVEL=debug
LOG_OUTPUT=dev

#
# MySQL DATABASE
#
TYPEORM_CONNECTION=mysql
TYPEORM_HOST=localhost
TYPEORM_PORT=your port
TYPEORM_USERNAME=<YOUR_DB_USERNAME>
TYPEORM_PASSWORD=<YOUR_DB_PASSWORD>
TYPEORM_DATABASE=<YOUR_DB_NAME>
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=["query", "error"]
TYPEORM_LOGGER=advanced-console

#
# PATH STRUCTURE
#
TYPEORM_MIGRATIONS=src/database/migrations/**/*.ts
TYPEORM_MIGRATIONS_DIR=src/database/migrations
TYPEORM_ENTITIES=src/api/models/**/*.ts,src/plugin-manager/models/**/*.ts
TYPEORM_ENTITIES_DIR=src/api/models
TYPEORM_SEEDING_FACTORIES=src/database/factories/**/*.ts
TYPEORM_SEEDING_SEEDS=src/database/seeds/**/*.ts
CONTROLLERS=src/api/controllers/**/*Controller.ts
MIDDLEWARES=src/api/middlewares/**/*Middleware.ts
INTERCEPTORS=src/api/interceptors/**/*Interceptor.ts
SUBSCRIBERS=src/api/subscribers/**/*Subscriber.ts
RESOLVERS=src/api/resolvers/**/*Resolver.ts

#
# Apidoc
#
APIDOC_ENABLED=true
APIDOC_ROUTE=/apidoc

#
# Status Monitor - CHANGE THESE CREDENTIALS!
#
MONITOR_ENABLED=true
MONITOR_ROUTE=/monitor
MONITOR_USERNAME=<YOUR_MONITOR_USERNAME>
MONITOR_PASSWORD=<YOUR_MONITOR_PASSWORD>

#
# Swagger - CHANGE THESE CREDENTIALS!
#
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/swagger
SWAGGER_FILE=api/swagger.json


#
# Mail Configuration
#
MAIL_DRIVER=smtp
MAIL_HOST=<YOUR_SMTP_HOST>
MAIL_USERNAME=<YOUR_EMAIL>
MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
MAIL_PORT=your port
MAIL_SECURE=true
MAIL_FROM=<YOUR_EMAIL>

#
# File Upload System (local or s3)
#
IMAGE_SERVER=s3

#
# AWS S3 Bucket Configuration
#
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
AWS_DEFAULT_REGION=<YOUR_AWS_REGION>
AWS_BUCKET=<YOUR_AWS_BUCKET_NAME>

#
# AWS SES (Simple Email Service) - Optional
#
SES_AWS_ACCESS_KEY_ID=<YOUR_SES_ACCESS_KEY>
SES_AWS_SECRET_ACCESS_KEY=<YOUR_SES_SECRET_KEY>
SES_AWS_REGION=<YOUR_SES_REGION>
SES_FROM_EMAIL=<YOUR_SES_FROM_EMAIL>

#
# Google Cloud Platform
#
GCP_CDN_FILEPATH=<YOUR_GCP_SERVICE_ACCOUNT_JSON_PATH>
GCP_CDN_PROJECT_ID=<YOUR_GCP_PROJECT_ID>
GCP_CDN_BUCKET=<YOUR_GCP_BUCKET_NAME>

#
# Application URLs
#
STORE_URL=http://localhost:your port/api
CANCEL_URL=http://localhost:your port/api
BASE_URL=http://localhost:your port/api
STORE_REDIRECT_URL=<YOUR_STORE_URL>
ADMIN_REDIRECT_URL=<YOUR_ADMIN_URL>
VENDOR_REDIRECT_URL=<YOUR_VENDOR_URL>
IMAGE_URL=<YOUR_IMAGE_URL>

#
# Password Reset URLs
#
STORE_FORGET_PASSWORD_URL=/account-verify
FORGET_PASSWORD_URL=<YOUR_FORGOT_PASSWORD_URL>
ADMIN_FORGET_PASSWORD_URL=<YOUR_ADMIN_URL>/#/set-password/

#
# Product & Category URLs
#
PRODUCT_REDIRECT_URL=/products/
CATEGORY_REDIRECT_URL=<YOUR_STORE_URL>/products/

#
# Security Configuration - GENERATE STRONG RANDOM SECRETS!
#
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_EXPIRY_TIME=7d
CRYPTO_SECRET=<YOUR_CRYPTO_SECRET>

#
# Login Attempts Configuration
#
LOGIN_ATTEPMTS_COUNT=5
LOGIN_ATTEPMTS_MINUTES=30

#
# File Upload Configuration
#
AVAILABLE_IMAGE_TYPES=PNG,png,jpg,jpeg
AVAILABLE_ALLOW_TYPES=PDF,pdf,xls,xlsx,doc,svg,docx,png
IMAGE_UPLOAD_SIZE=2

